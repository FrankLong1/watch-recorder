# Copy this file to TestFlight.local.env and fill in the values from
# App Store Connect -> Users and Access -> Integrations. The local file is
# ignored by Git. Keep the downloaded private key outside this repository.

ASC_KEY_ID="YOUR_KEY_ID"
ASC_ISSUER_ID="YOUR_ISSUER_ID"
ASC_KEY_PATH="/secure/path/outside-the-repository/AuthKey_YOUR_KEY_ID.p8"

# These defaults normally do not need to change.
ASC_BETA_GROUP="Internal"
ASC_LOCALE="en-US"
ASC_POLL_INTERVAL_SECONDS="30"
ASC_PROCESSING_TIMEOUT_SECONDS="3600"
