<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shown in the microphone permission prompt on the watch. Required:
	     the app is rejected at submission and crashes on first record without it. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>WristMemo records voice memos on your Apple Watch.</string>

	<!-- Single-target watchOS app (no legacy WatchKit extension). -->
	<key>WKApplication</key>
	<true/>

	<key>WKCompanionAppBundleIdentifier</key>
	<string>$(WRISTMEMO_APP_BUNDLE_ID)</string>

	<key>WristMemoIdentifierPrefix</key>
	<string>$(WRISTMEMO_BUNDLE_PREFIX)</string>

	<!-- Lets a recording that STARTED in the foreground keep running when the
	     user drops their wrist. watchOS will not let an app start audio from
	     the background; see LIMITATIONS.md. Audio is a UI background mode, not
	     a WK extended-runtime mode. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
