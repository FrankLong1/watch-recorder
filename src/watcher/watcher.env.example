# Copy this file to watcher.env on the remote workstation. The watcher obtains
# a short-lived token for its attached Google service account from the metadata
# server. There is no downloaded key or persistent feed secret.
export WRISTMEMO_WATCHER_FEED_URL="https://your-cloud-run-service.example"
export WRISTMEMO_GOOGLE_AUDIENCE="000000000000-example.apps.googleusercontent.com"
export WRISTMEMO_WATCHER_POLL_MS="60000"
export WRISTMEMO_WATCHER_FEED_TIMEOUT_MS="30000"
export WRISTMEMO_WATCHER_TASK_CWD="/home/user"

# Only set this for one explicit repair after inspecting recent Codex tasks and
# confirming that an interrupted thread/start request created no task.
# export WRISTMEMO_WATCHER_CONFIRM_NO_TASK="1"
