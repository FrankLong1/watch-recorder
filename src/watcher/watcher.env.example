# Install as ~/.config/wristmemo-watcher/watcher.env with mode 0600. The image
# contains code and startup wiring only; all values below are runtime config.
export WRISTMEMO_WATCHER_FEED_URL="https://your-cloud-run-service.example"
export WRISTMEMO_GOOGLE_AUDIENCE="000000000000-example.apps.googleusercontent.com"
export WRISTMEMO_WATCHER_TASK_CWD="${HOME}/Projects/your-project"

# Must match the Codex CLI version for which cross-process desktop discovery
# was manually verified. A Codex upgrade fails health until re-verified.
export WRISTMEMO_WATCHER_DESKTOP_DISCOVERY_CODEX_VERSION="0.145.0"

export WRISTMEMO_WATCHER_POLL_MS="20000"
export WRISTMEMO_WATCHER_FEED_TIMEOUT_MS="10000"
export WRISTMEMO_WATCHER_CURSOR_OVERLAP_MS="600000"
export WRISTMEMO_WATCHER_MAX_ATTEMPTS="5"

# Only set for one explicit repair after inspecting recent Codex tasks and
# confirming that an uncertain thread/start request created no task.
# export WRISTMEMO_WATCHER_CONFIRM_NO_TASK="1"
