# Copy this file to watcher.env on the remote workstation. The feed token is
# read-only: it cannot upload audio or read transcript text.
export WRISTMEMO_WATCHER_FEED_URL="https://your-cloud-run-service.example"
export WRISTMEMO_WATCHER_FEED_TOKEN="replace-with-the-dedicated-watcher-token"
export WRISTMEMO_WATCHER_POLL_MS="60000"
export WRISTMEMO_WATCHER_TASK_CWD="/home/user"
